# ---- Motores de IA ----
# Gemini: único motor con visión (lee PDF nativo). Se usa para CVs escaneados.
GEMINI_API_KEY=AIza...tu_clave...

# Groq: motor de texto (API compatible con OpenAI). Cuota diaria amplia (1.000
# req/día) pero NO lee PDF: el texto del CV se extrae localmente y se le manda.
# Sin clave, el motor se omite de todas las cadenas (no rompe nada).
GROQ_API_KEY=gsk_...tu_clave...

PORT=3000
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Cadenas de motores por tarea (lista separada por comas, en orden de preferencia).
# Cada entrada es "modelo" (Gemini) o "proveedor:modelo" (p. ej. groq:openai/gpt-oss-120b).
# Si el primero está saturado (503), con la cuota diaria agotada (429) o fue
# retirado (404), se pasa al siguiente SIN cortar la consulta (401/403/400 son
# fatales). Los pedidos con PDF adjunto saltean los motores que no leen PDF.
#
# Sugerencias y chat: interactivos y de mucho volumen → Groq primero, Gemini de respaldo.
# Scoring: prioriza calidad y visión → Gemini primero; Groq queda como último recurso
# (solo aplica cuando el CV se pudo extraer como texto).
# `gemini-3.1-flash-lite` va al final de las cadenas de Gemini porque su bucket
# diario es independiente del de la familia 3.5/3.6/3.8 (sobrevive si ese cupo se agota).
AI_SUGGEST_MODELS=groq:openai/gpt-oss-20b,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_CHAT_MODELS=groq:openai/gpt-oss-120b,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_SCORING_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,groq:openai/gpt-oss-120b

# (Compatibilidad) Los nombres viejos GEMINI_*_MODELS siguen leyéndose si no hay AI_*.
# AI_SUGGEST_MODEL=gemini-3.5-flash-lite
# AI_CHAT_MODEL=gemini-3.8-flash

# Cómo procesar cada CV:
#   auto (recomendado) → extrae el texto localmente; si el PDF no tiene capa de
#                        texto (escaneado) manda el PDF nativo a Gemini.
#   pdf                → manda siempre el PDF nativo (comportamiento previo).
AI_PDF_MODE=auto

# Nivel de razonamiento ("thinking") de los modelos Gemini 3: "low" responde más
# rápido, "high" razona más profundo (vacío = default del modelo). Groq lo ignora.
GEMINI_THINKING_LEVEL_SUGGEST=low
GEMINI_THINKING_LEVEL_CHAT=low
GEMINI_THINKING_LEVEL_SCORING=high

# Para modelos que usan presupuesto de tokens en vez de nivel (Gemini 2.5):
# 0 desactiva y -1 es automático. Vacío = no se envía.
# GEMINI_THINKING_BUDGET_SUGGEST=
# GEMINI_THINKING_BUDGET_CHAT=

# Tope de tokens de salida (vacío = sin tope explícito).
# GEMINI_MAX_OUTPUT_TOKENS=

# Latencia y failover de la IA.
# Timeout por intento (una llamada) y tope total por consulta/CV, en milisegundos.
AI_REQUEST_TIMEOUT_MS=45000
AI_TOTAL_TIMEOUT_MS=120000
# Cuántas veces se recorre la cadena completa antes de rendirse.
AI_FAILOVER_ROUNDS=2
# Circuit breaker: un motor que falla se enfría este tiempo (pasa al final de la
# cadena; si todos están fríos, igual se intentan).
AI_MODEL_COOLDOWN_MS=45000
# Reintentos rápidos del MISMO motor ante límite por minuto.
AI_SAME_MODEL_RETRIES=1
# RetryDelay (segundos) a partir del cual se considera cuota agotada (se salta).
AI_QUOTA_SWITCH_SECONDS=60

# Reintentos ante errores transitorios en los embeddings (no tienen failover de
# modelo: cambiar de embedding rompería la comparación de vectores guardados).
GEMINI_RETRIES_BATCH=3

# Mínimo de caracteres de texto extraído para considerarlo útil. Si el PDF tiene
# menos (escaneado o vacío), en modo "auto" se manda el PDF nativo a Gemini.
PDF_MIN_TEXT_CHARS=150
