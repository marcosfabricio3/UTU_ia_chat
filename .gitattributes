# Normalizacion de fin de linea.
# El repositorio guarda texto en LF; el checkout usa el formato nativo del SO.
* text=auto

# Binarios: nunca normalizar ni intentar diffs de texto
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Shell: siempre LF
*.sh text eol=lf

# Scripts de Windows: siempre CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
