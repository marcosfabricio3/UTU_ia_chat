# Dependencias
node_modules/

# Entorno / credenciales (NUNCA subir .env reales; solo el .example)
.env
.env.*
!.env.example

# Datos generados en tiempo de ejecucion (vacantes, CVs, vectores, jobs.json)
backend/src/data/

# Evidencia de UI (capturas locales, ~7 MB: se conservan en disco pero no se versionan)
docs/capturas/

# Temporales y backups (incluye jobs.json.tmp de la escritura atomica)
*.tmp
*.bak
*.orig

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
